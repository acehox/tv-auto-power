# Copy to .env and adjust (setup.ps1 does this for you).

# Input the PC is plugged into, exactly as the id in `tv source list`
# (HDMI1..HDMI4 on newer VIDAA firmware). Optional: if unset, the TV is not
# switched on power-on, and is turned off on PC sleep/shutdown whatever it shows.
# TV_INPUT=HDMI4

# TV MAC address for Wake-on-LAN. setup.ps1 fills it in if config.yaml has none.
# TV_MAC=AA:BB:CC:DD:EE:FF

# Wake-on-LAN attempts, 5 s apart, while the TV boots from deep standby.
TV_WOL_RETRIES=12

# Input-switch attempts after waking (~2.5 s apart). Raise if the log says
# "Could not confirm switch".
TV_SOURCE_RETRIES=6
